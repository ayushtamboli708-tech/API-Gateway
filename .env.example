# Copy to .env and adjust for your machine.
# Values shown here are the built-in defaults.

GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_REDIS_SOCKET_TIMEOUT=1.0
GATEWAY_REDIS_CONNECT_TIMEOUT=1.0

# JSON object: service name -> base URL
GATEWAY_BACKENDS={"users":"http://localhost:9001","orders":"http://localhost:9002"}

GATEWAY_PROXY_CONNECT_TIMEOUT=2.0
GATEWAY_PROXY_READ_TIMEOUT=3.0
GATEWAY_PROXY_WRITE_TIMEOUT=2.0
GATEWAY_PROXY_POOL_TIMEOUT=2.0
GATEWAY_PROXY_TOTAL_TIMEOUT=10.0
GATEWAY_PROXY_MAX_CONNECTIONS=100
GATEWAY_PROXY_MAX_KEEPALIVE_CONNECTIONS=20
GATEWAY_MAX_REQUEST_BODY_BYTES=10485760

GATEWAY_RETRY_MAX_ATTEMPTS=2
GATEWAY_RETRY_BASE_DELAY=0.5

GATEWAY_BREAKER_FAILURE_THRESHOLD=5
GATEWAY_BREAKER_RECOVERY_TIMEOUT=30.0
GATEWAY_BREAKER_HALF_OPEN_TIMEOUT=5.0

GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_QUOTA_TTL_SECONDS=2678400

# JSON array. Leave empty to disable CORS.
GATEWAY_CORS_ORIGINS=[]
